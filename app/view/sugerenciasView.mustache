<link rel="stylesheet" href="/public/css/pregunta-form.css">
<main class="contenedor-pregunta-form">
    <h1 class="titulo-pregunta-form">Sugerir pregunta</h1>

    <p class="subtitulo-pregunta-form">Cargá una pregunta para que el equipo la revise antes de sumarla al juego.</p>

    <div id="alerta-error" class="alerta-pregunta-form alerta-error" role="alert" {{^error}}hidden{{/error}}>
        <p>{{error}}</p>
    </div>

    <div id="alerta-exito" class="alerta-pregunta-form alerta-exito" role="status" {{^exito}}hidden{{/exito}}>
        <p>{{exito}}</p>
    </div>

    <form id="form-sugerencia" method="post" action="/sugerencias/enviarSugerencia">

        <div class="grupo-formulario">
            <label for="descripcion">Enunciado de la pregunta:</label>
            <textarea id="descripcion" name="descripcion" required></textarea>
        </div>

        <div class="grupo-formulario">
            <label for="opcion_a">Opción A:</label>
            <input type="text" id="opcion_a" name="opcion_a" required>
        </div>

        <div class="grupo-formulario">
            <label for="opcion_b">Opción B:</label>
            <input type="text" id="opcion_b" name="opcion_b" required>
        </div>

        <div class="grupo-formulario">
            <label for="opcion_c">Opción C:</label>
            <input type="text" id="opcion_c" name="opcion_c" required>
        </div>

        <div class="grupo-formulario">
            <label for="opcion_d">Opción D:</label>
            <input type="text" id="opcion_d" name="opcion_d" required>
        </div>

        <div class="grupo-formulario">
            <label for="respuesta_correcta">Opción Correcta:</label>
            <select id="respuesta_correcta" name="respuesta_correcta" required>
                <option value="A">A</option>
                <option value="B">B</option>
                <option value="C">C</option>
                <option value="D">D</option>
            </select>
        </div>

        <div class="grupo-formulario">
            <label for="categoria">Categoría:</label>
            <select id="categoria" name="categoria" required>
                <option value="Historia">Historia</option>
                <option value="Cultura">Cultura</option>
                <option value="Deporte">Deporte</option>
                <option value="Arte">Arte</option>
                <option value="Ciencia">Ciencia</option>
            </select>
        </div>

        <div class="acciones-pregunta-form">
            <button type="submit" class="btn-pregunta-form btn-principal">
                Enviar sugerencia
            </button>

            <a href="/lobby/show" class="btn-pregunta-form btn-secundario">
                Volver al Lobby
            </a>
        </div>

    </form>
</main>

<script>
    (() => {
        const form = document.getElementById('form-sugerencia');
        const alertaError = document.getElementById('alerta-error');
        const alertaExito = document.getElementById('alerta-exito');
        const textError = alertaError.querySelector('p');
        const textExito = alertaExito.querySelector('p');

        const ocultarAlertas = () => {
            alertaError.hidden = true;
            alertaExito.hidden = true;
        };

        const mostrarError = (mensaje) => {
            textError.textContent = mensaje;
            alertaError.hidden = false;
            alertaExito.hidden = true;
        };

        const mostrarExito = (mensaje) => {
            textExito.textContent = mensaje;
            alertaExito.hidden = false;
            alertaError.hidden = true;
            form.reset();
        };

        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            ocultarAlertas();

            const boton = form.querySelector('button[type="submit"]');
            boton.disabled = true;

            try {
                const respuesta = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const datos = await respuesta.json();

                if (datos.ok) {
                    mostrarExito(datos.mensaje || 'La sugerencia ha sido enviada!');
                } else {
                    mostrarError(datos.error || 'No se pudo enviar la sugerencia. Probá de nuevo.');
                }
            } catch (error) {
                mostrarError('No se pudo enviar la sugerencia. Revisá tu conexión y probá de nuevo.');
            } finally {
                boton.disabled = false;
            }
        });
    })();
</script>
