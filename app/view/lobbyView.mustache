<div class="w3-content" style="max-width:900px">

    <header class="lobby-header w3-panel w3-card w3-padding-16">
        <h1>{{nombre}} · {{textoPosicion}} · {{puntaje}} pts</h1>
        <a class="trampitas {{#sinTrampitas}}vacio{{/sinTrampitas}}"
           href="/TPFinal-Web2/index.php?controller=trampita&method=show">
            Trampitas: {{trampitas}}
        </a>
    </header>

    <nav class="lobby-acciones">
        <a href="/TPFinal-Web2/index.php?controller=partida&method=show" class="w3-button w3-round">Nueva partida</a>
        <a href="/TPFinal-Web2/index.php?controller=ranking&method=show" class="w3-button w3-round">Ranking</a>
        <a href="/TPFinal-Web2/index.php?controller=pregunta&method=show" class="w3-button w3-round">Sugerir pregunta</a>
    </nav>

    {{#hayDesafios}}
        <section>
            <h2>Desafíos pendientes</h2>
            {{#desafios}}
                {{> desafioItem}}
            {{/desafios}}
        </section>
    {{/hayDesafios}}

    <section>
        <h2>Mis partidas</h2>
        {{^hayPartidas}}
            <p>Todavía no jugaste ninguna partida.</p>
            <a href="/TPFinal-Web2/index.php?controller=partida&method=show" class="w3-button w3-round">Empezar a jugar</a>
        {{/hayPartidas}}
        {{#partidas}}
            {{> partidaItem}}
        {{/partidas}}
    </section>

</div>