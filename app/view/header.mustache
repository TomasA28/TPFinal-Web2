<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Trivia Night</title>
    <link rel="icon" type="image/x-icon" href="/public/css/images/icon.ico">
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
    <link rel="stylesheet" href="/public/css/styles.css">
    <script>
        window.mapsApiReady = false;

        function onMapsApiReady() {
            window.mapsApiReady = true;
            document.dispatchEvent(new Event("maps-api-ready"));
        }

        // Ejecuta la inicialización del mapa de la vista actual cuando la API esté lista.
        function runMapInit(callback) {
            if (window.mapsApiReady) {
                callback();
            } else {
                document.addEventListener("maps-api-ready", callback, { once: true });
            }
        }
    </script>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBchKh_N1E7t_yCvK6Cu3pUogZS-EATvTs&loading=async&callback=onMapsApiReady"></script>
</head>

<body>

    <div class="barraNav">
        {{#logueado}}
        <a href="/lobby/show" class="botonNav">
            <img src="/public/css/images/logo.png" alt="TriviaNight Logo" class="homeButton">
        </a>

        <a href="/perfil/show" class="botonNav" id="botonPerfil">
            {{#fotoDePerfil}}
            <img src="/public/subidas/{{fotoDePerfil}}" alt="Foto de perfil" class="profileButton">
            {{/fotoDePerfil}}
            {{^fotoDePerfil}}
            <img src="/public/css/images/userIcon.jpg" alt="Botón de perfil" class="profileButton">
            {{/fotoDePerfil}}
        </a>
        {{/logueado}}

        {{^logueado}}
        <a href="/" class="botonNav">
            <img src="/public/css/images/logo.png" alt="TriviaNight Logo" class="homeButton">
        </a>
        {{/logueado}}
    </div>