<link rel="stylesheet" href="/public/css/ranking.css">

<main class="ranking-page">
    <div class="ranking-header">
        <a href="/lobby/show" class="backButton"><span aria-hidden="true">←</span> Volver al lobby</a>
        <h1>Ranking</h1>
    </div>

    <p class="ranking-intro">Puntaje acumulado de los jugadores en el período seleccionado</p>

    <form class="ranking-filter" method="get" action="/ranking/show">
        <label for="ranking-periodo">Período:</label>
        <select id="ranking-periodo" name="periodo">
            <option value="dia" {{#periodo_dia}}selected{{/periodo_dia}}>Diario</option>
            <option value="semana" {{#periodo_semana}}selected{{/periodo_semana}}>Semanal</option>
            <option value="mes" {{#periodo_mes}}selected{{/periodo_mes}}>Mensual</option>
        </select>
        <button type="submit">Filtrar</button>
    </form>

    {{#hay_ranking}}
        <div class="ranking-tableBox">
            <table class="ranking-table">
                <thead>
                <tr>
                    <th scope="col">Posición</th>
                    <th>Jugador</th>
                    <th>Puntaje</th>
                </tr>
                </thead>
                <tbody>
                {{#ranking}}
                    <tr {{#es_usuario_actual}}class="usuario-actual"{{/es_usuario_actual}}
                    {{^es_usuario_actual}}class="otroUsuario"{{/es_usuario_actual}}>
                        <td>{{posicion}}</td>
                        <td><a href="{{perfilDelUsuario}}">{{usuario}}</a></td>
                        <td>{{puntaje}}</td>
                    </tr>
                {{/ranking}}
                </tbody>
            </table>
        </div>
    {{/hay_ranking}}

    {{^hay_ranking}}
        <p class="ranking-empty">Todavía no hay jugadores en el ranking.</p>
    {{/hay_ranking}}
</main>
