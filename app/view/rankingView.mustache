<link rel="stylesheet" href="/public/css/ranking.css">

<main class="ranking-page">
    <div class="ranking-header">
        <a href="/lobby/show" class="backButton"><span aria-hidden="true">←</span> Volver al lobby</a>
        <h1>Ranking</h1>
    </div>

    {{#hay_ranking}}
        <div class="ranking-tableBox">
            <table class="ranking-table">
                <thead>
                <tr>
                    <th>#</th>
                    <th>Jugador</th>
                    <th>Puntaje</th>
                </tr>
                </thead>
                <tbody>
                {{#ranking}}
                    <tr {{#es_usuario_actual}}class="usuario-actual"{{/es_usuario_actual}}
                    {{^es_usuario_actual}}class="otroUsuario"{{/es_usuario_actual}}>
                        <td>{{posicion}}</td>
                        <td><a href="{{perfilDelUsuario}}">{{usuario}}</a></td>
                        <td>{{puntaje}}</td>
                    </tr>
                {{/ranking}}
                </tbody>
            </table>
        </div>
    {{/hay_ranking}}

    {{^hay_ranking}}
        <p class="ranking-empty">Todavía no hay jugadores en el ranking.</p>
    {{/hay_ranking}}
</main>
