<main class="trampitas-page">
    <section class="trampitas-card">
        <h1>Mis trampitas</h1>

        <p class="trampitas-saldo">
            <span>Saldo disponible:</span>
            <strong>🪄 {{saldo}}</strong>
        </p>

        {{#compra_ok}}
            <p class="trampitas-mensaje trampitas-mensaje--exito">
                Compra simulada realizada. Ya tenés las trampitas en tu saldo.
            </p>
        {{/compra_ok}}

        {{#error}}
            <p class="trampitas-mensaje trampitas-mensaje--error">
                No se pudo completar la operación. Probá de nuevo.
            </p>
        {{/error}}

        <h2>Comprar trampitas</h2>

        <form action="/trampitas/comprar" method="POST"
              class="trampitas-acciones">
            <button type="submit" name="cantidad" value="1"
                    class="trampitas-boton">
                1 trampita — USD 1
            </button>

            <button type="submit" name="cantidad" value="5"
                    class="trampitas-boton">
                5 trampitas — USD 5
            </button>

            <button type="submit" name="cantidad" value="10"
                    class="trampitas-boton">
                10 trampitas — USD 10
            </button>
        </form>

        <p class="trampitas-aviso">
            <small>El pago es simulado.</small>
        </p>

        <section class="trampitas-historial">
            <h2>Historial</h2>

            <div class="trampitas-tabla-contenedor">
                <table class="trampitas-tabla">
                    <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Movimiento</th>
                        <th>Cantidad</th>
                    </tr>
                    </thead>

                    <tbody>
                    {{#movimientos}}
                        <tr>
                            <td>{{fecha_formateada}}</td>
                            <td>{{tipo}}</td>
                            <td class="{{#es_ingreso}}mov-ingreso{{/es_ingreso}}{{^es_ingreso}}mov-egreso{{/es_ingreso}}">
                                {{cantidad_formateada}}
                            </td>
                        </tr>
                    {{/movimientos}}

                    {{^movimientos}}
                        <tr>
                            <td colspan="3">
                                Todavía no tenés movimientos.
                            </td>
                        </tr>
                    {{/movimientos}}
                    </tbody>
                </table>
            </div>
        </section>

        <p class="trampitas-volver">
            <a href="/lobby/show">Volver al lobby</a>
        </p>
    </section>
</main>